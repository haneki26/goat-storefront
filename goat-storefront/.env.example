# Shopify Storefront API (safe to expose: public token, read products + manage carts)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
NEXT_PUBLIC_SHOPIFY_API_VERSION=2025-07

# Hero background video (MP4/WebM uploaded to Shopify Files or any CDN)
NEXT_PUBLIC_HERO_VIDEO_URL=
NEXT_PUBLIC_HERO_POSTER_URL=

# Site
NEXT_PUBLIC_SITE_URL=https://goatpeakperformance.com
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=799

# Shown instantly in the popup/waitlist on signup (with a copy button), and also emailed by the Klaviyo welcome flow.
# Must match the code you created in Shopify > Discounts. Optional — falls back to "WELCOME10" if unset.
NEXT_PUBLIC_WELCOME_CODE=WELCOME10

# Email capture (server-only). Klaviyo shown; swap for your provider.
KLAVIYO_PRIVATE_KEY=
KLAVIYO_LIST_ID=

# Live Instagram feed (Graph API, Business/Creator account)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
